# Destino del proxy de Vite en desarrollo (/api y /auth). Si no se define, usa http://localhost:8080.
# Para trabajar contra el backend de producción (Render):
VITE_PROXY_TARGET=https://backendmobiliariodeoficina.onrender.com

# true: los servicios devuelven datos de src/mocks/ · false: llaman a la API real
VITE_USE_MOCKS=true

# Solicitud de cotización (POST /api/v1/cotizaciones, propuesta en API.md; el backend aún la desarrolla).
# false: Mi cotización se envía solo por WhatsApp · true: aparece el formulario "Solicitar cotización".
# Con VITE_USE_MOCKS=true se puede probar el formulario sin backend. En Vercel se define en sus variables.
VITE_COTIZACION_API=false

# Favoritos en la cuenta (/api/v1/favoritos). Publicado, pero hoy falla con token: pendiente 27 de API.md.
# false: los favoritos viven solo en este navegador (Pinia + localStorage) · true: con sesión iniciada
# se sincronizan con la cuenta (sin sesión, igual que false). Con VITE_USE_MOCKS=true se puede probar
# sin backend. En Vercel se define en sus variables.
VITE_FAVORITOS_API=false

# Client ID de Google para "Continuar con Google". Sale de Google Cloud Console › APIs y servicios ›
# Credenciales › ID de cliente de OAuth 2.0 (tipo "Aplicación web"); termina en .apps.googleusercontent.com.
# Lo crea el compañero del backend: tiene que ser el mismo que valida /auth/v1/google (pendiente 7 de API.md).
# No es secreto (viaja al navegador), pero va aquí para no fijarlo en el código.
# Vacío: login y registro ocultan el botón (con mocks, en npm run dev, sale uno simulado).
# En Vercel se define en sus variables de entorno y hay que volver a desplegar.
VITE_GOOGLE_CLIENT_ID=
