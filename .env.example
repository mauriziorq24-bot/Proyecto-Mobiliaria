# Destino del proxy de Vite en desarrollo (/api y /auth). Si no se define, usa http://localhost:8080.
# Para trabajar contra el backend de producción (Render):
VITE_PROXY_TARGET=https://backendmobiliariodeoficina.onrender.com

# true: los servicios devuelven datos de src/mocks/ · false: llaman a la API real
VITE_USE_MOCKS=true

# Client ID de Google (el mismo que valida el backend; pendiente 7 de API.md).
# Vacío: login y registro ocultan "Continuar con Google". En Vercel se define en sus variables de entorno.
VITE_GOOGLE_CLIENT_ID=
