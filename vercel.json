{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backendmobiliariodeoficina.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://backendmobiliariodeoficina.onrender.com/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
